NEXT_PUBLIC_API_URL=http://localhost:8000

# Public key ID only (never the secret) — powers the real Razorpay
# Checkout.js modal in the Execute Transaction panel. Same value as the
# backend's RAZORPAY_KEY_ID.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# Server-only (no NEXT_PUBLIC_ prefix — never sent to the browser). Must
# match the backend's AGENTGATE_HMAC_SECRET exactly. Used by the
# app/api/agentgate/* route handlers to sign create/spend/revoke calls on
# the backend's behalf (see backend/app/auth.py and lib/serverAuth.ts).
AGENTGATE_HMAC_SECRET=dev-only-change-me

# Backend URL reachable from the Next.js *server* process. In local dev
# this is the same as NEXT_PUBLIC_API_URL above, so it can be left unset;
# Docker Compose sets it to http://api:8000 (the internal service
# hostname) since the web container can't reach the backend via
# localhost.
# INTERNAL_API_URL=http://localhost:8000
